000003be <i2cSet>:

uint8_t i2cReadLastByte(){
	TWCR= ((1<< TWINT) | (1<< TWEN));	//Disable ACK. Creates a NACK condition which signals the slave to stop sending data.
	while(!(TWCR & (1<< TWINT)));
	return TWDR;	//If ack is sent, return data.
}
