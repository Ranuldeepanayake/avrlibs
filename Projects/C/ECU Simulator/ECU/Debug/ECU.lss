uint8_t readNack(){
	TWCR= ((1<< TWINT) | (1<< TWEN));	//Disable ACK. Sends NACK to sender after receiving data to signal the sender to stop sending data.
	while(!(TWCR & (1<< TWINT)));
	return TWDR;
}
